+def _retail_gap(project, module, objs, start, end):
+    """Retail bytes of an unlabelled range [start, end) of a pool, read from the retail split
+    object holding the closest preceding pool object. None when that object does not cover the
+    range contiguously, another symbol of it claims the bytes, or a relocation touches them."""
+    from .dataimport import objects
+    prev = max((s for s in objs if s.end <= start), key=lambda s: s.end, default=None)
+    if prev is None:
+        return None
+    index = objects(project, module)
+    pair = index.get(prev.name) or index.get(f'{prev.name}_{prev.addr:08X}')
+    if not pair:
+        return None
+    relf, es = pair
+    shndx = es['shndx']
+    sec = relf.sections[shndx]
+    lo = es['value'] + (start - prev.addr)
+    hi = lo + (end - start)
+    if sec['type'] != 1 or lo < es['value'] + es['size'] or hi > sec['size']:
+        return None
+    if any(s['shndx'] == shndx and s['size'] and s['value'] < hi and s['value'] + s['size'] > lo
+           for s in relf.symbols()):
+        return None
+    for rsec in relf.sections:
+        if rsec['type'] != 4 or rsec['info'] != shndx:
+            continue
+        for pos in range(rsec['offset'], rsec['offset'] + rsec['size'], 12):
+            offset = struct.unpack_from('>I', relf.data, pos)[0]
+            if offset < hi and offset + 4 > lo:
+                return None
+    return bytes(relf.data[sec['offset'] + lo:sec['offset'] + hi])
+
