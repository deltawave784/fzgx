@@ -19,6 +19,15 @@ A body that calls a function it never declares (`oracle.body_diagnostics`: MWCC'
 loses IMPLICIT_PENALTY points, the same margin `api.IMPLICIT_MARGIN` applies to the
 attempt's saved best, so a sound body within that margin seeds the next attempt.
 
+The score itself is `selection_score`: the mean of objdiff's similarity (partial credit for
+register-only rows, but a correctly bound literal pool or section base still counts as a
+mismatch) and the row score (100 x the share of aligned instruction rows that agree after the
+oracle's accepted pool/section/absolute relocations: `oracle.progress_rows`). Ranking by the
+better of the two scales alone (`oracle.progress_score`, the attempt's progress scale) kept
+fn_10_111E8's 88.6% seed with 208 differing rows over the primed rewrite at 85.5% with 111
+rows and the pool bound, and fn_3_C400's 99.08% body with 25 rows over 98.9% with 10
+(round 55, measured over 1,100 functions with two or more saved bodies).
+
 Results are cached per (symbol, body hash, compiler, flags) in
 .fzgx/seedrank.json, so a ranking compiles each candidate body once.
 """
@@ -120,6 +129,37 @@ def penalty(dropped: Optional[Sequence[str]]) -> float:
     return min(MAX_PENALTY, PENALTY * len(dropped or ()))
 
 
+def row_score(res) -> Optional[float]:
+    """100 x the share of aligned instruction rows that agree once the oracle's accepted
+    relocation rows (pool, section base, absolute) are taken out; None without a row alignment.
+    Equals `percent_adjusted` when accepted rows exist and the same formula otherwise."""
+    from . import oracle
+    rows = oracle.progress_rows(res)
+    n = getattr(res, "instruction_rows", 0) or 0
+    if rows is None or n <= 0:
+        return None
+    return round(100.0 * max(0, n - rows) / n, 4)
+
+
+def selection_score(raw: Optional[float], rows: Optional[float], dropped: Optional[Sequence[str]] = None,
+                    implicit: bool = False) -> float:
+    """The ranking scale for saved bodies and seeds (selection only, never acceptance):
+    the mean of objdiff's similarity and the pool-aware row score, less the dropped-row and
+    undeclared-callee penalties. Without a row score the raw score stands alone."""
+    raw = raw or 0.0
+    base = raw if rows is None else (raw + rows) / 2.0
+    return base - penalty(dropped) - (IMPLICIT_PENALTY if implicit else 0.0)
+
+
+def selection_of(res, dropped: Optional[Sequence[str]] = None, implicit: bool = False) -> float:
+    """selection_score of a CheckResult (0 when it did not compile)."""
+    if not res.ok:
+        return 0.0
+    if res.matched or getattr(res, "matched_pool", False):
+        return 100.0
+    return selection_score(res.percent, row_score(res), dropped, implicit)
+
+
